# DEO 6.3 — secrets and overrides (never commit .env)

# Required for anonymized exports (min 32 bytes)
# PSEUDONYM_SALT=

# Optional observability
# SENTRY_DSN=
# LOG_LEVEL=INFO

# Bluesky API (atproto login; use app password, not main account password)
# BLUESKY_HANDLE=
# BLUESKY_APP_PASSWORD=

# Optional bearer token if using authenticated endpoints directly
# BLUESKY_AUTH_TOKEN=

# BGA_ nested overrides (optional), e.g. BGA_COLLECTION__SNAPSHOT_ID=snap_dev
